# Copy this file to `.env` (same folder as docker-compose.yml) and fill in
# real values. `.env` is read by docker-compose and passed into the
# container as environment variables when you run `docker compose up`.
# Never commit the real `.env` file -- keep it out of git.

# --- Required ---------------------------------------------------------

# Your Discord bot token, from the Discord Developer Portal.
# Read in core/bot.py via os.getenv("TOKEN").
TOKEN=

# Full MongoDB Atlas connection string (mongodb+srv://user:pass@cluster...).
# Read in databases/mongo.py via os.getenv("DATABASE").
DATABASE=

# --- Optional -----------------------------------------------------------

# Used by a couple of admin-cog diagnostics as a fallback if you want a
# separate URI from DATABASE for those checks. Safe to leave blank --
# admin.py falls back to the live Mongo client's own URI if unset.
MONGO_URI=

# Path *inside the container* to a pickled Mega.nz credentials file
# (core/bot.py: connect_mega_account). Only needed if you use Mega for
# backups/storage -- if unset, the bot logs in anonymously instead.
# Leave this AND MEGA_HOST_PATH below blank if you don't use Mega, and
# comment out the corresponding volume line in docker-compose.yml.
MEGA=/app/secrets/mega.pkl

# Path *on the host* to that same pickle file -- only used by
# docker-compose.yml to mount it into the container read-only.
MEGA_HOST_PATH=./secrets/mega.pkl
